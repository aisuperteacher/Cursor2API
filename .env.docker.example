# Copy to .env before running docker compose.
API_PORT=6718
ADMIN_PASSWORD=replace-with-a-strong-admin-password
PUBLIC_BASE_URL=
TRUST_PROXY_HEADERS=false
ADMIN_LOGIN_MAX_FAILURES=5
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_LOCKOUT_MS=900000
# One key may use CURSOR_API_KEY. Multiple keys may be comma/newline separated,
# label=key entries, or a JSON array of strings / {"label","key"} objects.
# These environment-backed credentials are reloaded after every restart. To
# remove an invalid one, delete it here and recreate the API container; the
# control console intentionally cannot permanently delete .env credentials.
CURSOR_API_KEY=
CURSOR_API_KEYS=
CURSOR_SDK_BRIDGE_TOKEN=replace-with-a-long-random-token
CURSOR_SDK_BRIDGE_IDLE_TIMEOUT_MS=300000
CURSOR_SDK_BRIDGE_HARD_TIMEOUT_MS=600000
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Optional Cursor team Admin API integration. Admin API keys start with key_,
# and are not interchangeable with the crsr_ SDK/API keys above.
CURSOR_ADMIN_API_KEY=
CURSOR_ADMIN_API_BASE_URL=https://api.cursor.com
CURSOR_ADMIN_USAGE_LOOKBACK_DAYS=30
CURSOR_ADMIN_API_TIMEOUT_MS=10000

# Bounded metadata-only request logs.
REQUEST_LOG_ENABLED=true
REQUEST_LOG_RETENTION_DAYS=7
REQUEST_LOG_MAX_FILE_BYTES=10485760
REQUEST_LOG_MAX_FILES=10
REQUEST_LOG_MAX_TOTAL_BYTES=104857600
REQUEST_LOG_CLEANUP_INTERVAL_MS=3600000

# Docker Hub namespace and optional version tag. Both Compose files use these
# images by default; retain the optional overrides only for a private registry.
CURSOR2API_IMAGE_NAMESPACE=nglsg
CURSOR2API_IMAGE_TAG=latest
# CURSOR2API_API_IMAGE=registry.example.com/cursor2api-api:latest
# CURSOR2API_BRIDGE_IMAGE=registry.example.com/cursor2api-bridge:latest

ENCRYPTION_KEY="replace-with-a-long-random-secret"
CURSOR_API_KEY=""
CURSOR_API_KEYS=""
ADMIN_PASSWORD=""
PUBLIC_BASE_URL=""
LOCAL_AUTH_STATE_PATH=""
CURSOR_ROUTER_STATE_PATH=""
CURSOR_BACKEND_BASE_URL=""
CURSOR_CHAT_ENDPOINT=""
CURSOR_SDK_BRIDGE_URL=""
# A token is required whenever CURSOR_SDK_BRIDGE_HOST is not loopback.
CURSOR_SDK_BRIDGE_TOKEN=""
TRUST_PROXY_HEADERS="false"
ADMIN_LOGIN_MAX_FAILURES="5"
ADMIN_LOGIN_WINDOW_MS="900000"
ADMIN_LOGIN_LOCKOUT_MS="900000"
CURSOR_SDK_BRIDGE_TIMEOUT_MS="300000"
CURSOR_SDK_BRIDGE_IDLE_TIMEOUT_MS="300000"
CURSOR_SDK_BRIDGE_HARD_TIMEOUT_MS="600000"
CURSOR_CLIENT_VERSION="2.6.22"
CURSOR_SDK_CLIENT_VERSION="sdk-1.0.13"
# Optional Cursor team Admin API key (key_...). This is different from crsr_ SDK keys.
CURSOR_ADMIN_API_KEY=""
CURSOR_ADMIN_API_BASE_URL="https://api.cursor.com"
CURSOR_ADMIN_USAGE_LOOKBACK_DAYS="30"
CURSOR_ADMIN_API_TIMEOUT_MS="10000"
# Request logs contain metadata only; prompts, messages, tool payloads and secrets are never stored.
REQUEST_LOG_ENABLED="true"
REQUEST_LOG_DIR="/var/lib/api-for-cursor/logs"
REQUEST_LOG_RETENTION_DAYS="7"
REQUEST_LOG_MAX_FILE_BYTES="10485760"
REQUEST_LOG_MAX_FILES="10"
REQUEST_LOG_MAX_TOTAL_BYTES="104857600"
REQUEST_LOG_CLEANUP_INTERVAL_MS="3600000"
WAITLIST_API_TOKEN=""
CURSOR_API_APPCAST_URL="https://api-for-composer.standardagents.ai/appcast.xml"
CURSOR_API_RELEASE_BASE_URL="https://api-for-composer.standardagents.ai/releases"
